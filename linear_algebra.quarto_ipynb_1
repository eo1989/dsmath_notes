   "source": [
    "# covariance\n",
    "covMat = _dataMatrixMean.T @ _dataMatrixMean  # data matrix times its transpose\n",
    "covMat /= _dataMatrixMean.shape[0] - 1  # divide by N - 1\n",
    "\n",
    "# use a dynamic color scale\n",
    "clim = np.max(np.abs(covMat)) * 0.2\n",
    "\n",
    "plt.figure(figsize=(6, 6))\n",
    "plt.imshow(covMat, vmin=-clim, vmax=clim, cmap=\"afmhot\")\n",
    "plt.colorbar()\n",
    "plt.title(\"Data Covariance Matrix\")\n",
    "plt.savefig(\"Figure_ch07_01_LinAlg4DS.png\", dpi=300)\n",
    "plt.show()"
   ]
