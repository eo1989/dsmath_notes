# <<ipynb_nvim:code>>
using Distributions, DataFrames, PrettyTables, Interact, PlotlyJS
# <</ipynb_nvim>>

# <<ipynb_nvim:code>>
N(x) = cdf(Normal(0, 1), x)

function BSM(S, K, T, r, d, σ, cp)
    """
    CP is a call put flag, 1 for call, -1 for put. ignoring it the formula is:
    ℯ^{-d * T} * S * N(d1) - K * ℯ^{-r * T} * N(d2)

    """
    d1 = (log(S / K) + (r - d + σ^2 / 2) * T) / (σ * √(T))
    d2 = d1 - σ * √(T)
    opt = exp(-d * T) * cp * S * N(cp * d1) - cp * K * exp(-r * T) * N(cp * d2)
    delta = cp * exp(-d * T) * N(cp * d1)
    return Float64(opt), Float64(delta)
end
# <</ipynb_nvim>>

# <<ipynb_nvim:code>>
# Use ARWR price at 1411 on 12/02/2025 as an example
# ARWR: 58.97, iv: 67%, div: 0%, r: 4.0%
# 60C 12/18/25 expiry (17dte)  w/ iv: 75%

# Use AXSM price at 1427 on 12/31/2025 as an example
# AXSM: 183.30, iv: 40%, div: 0%, r: 3.75%
# 210C 01/16/2026 expiry (16dte) w/ iv: 42%

S, K, T, d, r, σ = 183.30, 210, 16 / 252, 0, 0.0375, 0.42
call = BSM(S, K, T, r, d, σ, 1)
put = BSM(S, K, T, r, d, σ, -1)
df = DataFrame("Call" => call[1], "Delta Call" => call[2], "Put" => put[1], "Delta Put" => put[2])
PrettyTables.pretty_table(
    df,
    border_crayon=Crayons.crayon"blue",
    header_crayon=Crayons.crayon"bold green",
    formatters=ft_printf("%.2f", [1, 2, 3, 4])
)
# <</ipynb_nvim>>

# <<ipynb_nvim:code>>
println("Put price according to BSM = $(round(put[1], digits = 2))")

function Black76(F, K, t, r, σ, cp)
    d1 = (log(F / K) + 0.5 * σ^2 * t) / σ * √(t)
    d2 = d1 - σ * √(t)
    opt = cp * exp(-r * t) * (F * N(cp * d1) - K * N(cp * d2))
    return Float64(opt)
end
# <</ipynb_nvim>>

